# =====================================================
# CONFIGURAÇÃO OPÇÃO B: Banco → Planilhas (Sincronização)
# =====================================================
# Adicione estas variáveis ao seu arquivo .env
# As planilhas serão VISUALIZAÇÕES do banco de dados
# =====================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PLANILHAS DE ENGENHEIROS (Visualização filtrada)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Planilha Engenheiro 1
GOOGLE_SHEETS_ENG1_ID=sua_planilha_id_aqui
GOOGLE_SHEETS_ENG1_NAME=Engenheiro(a)
GOOGLE_SHEETS_ENG1_RANGE=A2:AE1000
GOOGLE_SHEETS_ENG1_WHATSAPP=+5511999999999

# Planilha Engenheiro 2 (opcional)
# GOOGLE_SHEETS_ENG2_ID=sua_planilha_id_aqui
# GOOGLE_SHEETS_ENG2_NAME=Engenheiro(a)
# GOOGLE_SHEETS_ENG2_RANGE=A2:AE1000
# GOOGLE_SHEETS_ENG2_WHATSAPP=+5511888888888

# Planilha Engenheiro 3 (opcional)
# GOOGLE_SHEETS_ENG3_ID=sua_planilha_id_aqui
# GOOGLE_SHEETS_ENG3_NAME=Engenheiro(a)
# GOOGLE_SHEETS_ENG3_RANGE=A2:AE1000
# GOOGLE_SHEETS_ENG3_WHATSAPP=+5511777777777

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PLANILHA CEO (Dashboard consolidado - opcional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GOOGLE_SHEETS_CEO_ID=sua_planilha_id_aqui
# GOOGLE_SHEETS_CEO_NAME=Dashboard
# GOOGLE_SHEETS_CEO_RANGE=A2:K1000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AGENDAMENTO (Quanto tempo entre sincronizações)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# A cada 5 minutos (recomendado)
SYNC_CRON_SCHEDULE=*/5 * * * *

# Outras opções:
# */2 * * * *       → a cada 2 minutos (mais rápido)
# */10 * * * *      → a cada 10 minutos
# 0 * * * *         → a cada hora
# 0 8,12,18 * * *   → às 8h, 12h e 18h apenas

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COMO OBTER OS IDs DAS PLANILHAS:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Abra a planilha no Google Sheets
# 2. Copie o ID da URL:
#    https://docs.google.com/spreadsheets/d/[ID_AQUI]/edit
#                                            ↑
#                                      Copie isso
# 3. Cole no .env
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ESTRUTURA DA PLANILHA:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Aba: Engenheiro(a)
# Linha 1: Headers (31 colunas: A até AE)
# Linha 2+: Dados (preenchidos automaticamente)
#
# Veja: CONFIGURACAO_RAPIDA_PLANILHAS.md
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

