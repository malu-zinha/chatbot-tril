# ==============================================
# EXEMPLO DE CONFIGURAÇÃO - .env.example
# ==============================================
# Copie este arquivo para .env e preencha com seus dados

# ==============================================
# GOOGLE SHEETS API
# ==============================================
# Obtenha em: https://console.cloud.google.com/
# Tutorial: https://developers.google.com/sheets/api/quickstart/nodejs

GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_SHEETS_ENGINEER_ID=1aarPLXxntXJrivOa-rLY5uugSwO59Of7KWm8PorTqXs
GOOGLE_SHEETS_ENGINEER_NAME=Engenheira(o)
GOOGLE_SHEETS_ENGINEER_SHEET=Engenheira(o)
GOOGLE_SHEETS_ENGINEER_RANGE=A3:AE1000

# ==============================================
# SUPABASE (BANCO DE DADOS)
# ==============================================
# Obtenha em: https://supabase.com/dashboard
# Opcional mas altamente recomendado para produção

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================
# TWILIO WHATSAPP API
# ==============================================
# Obtenha em: https://console.twilio.com/
# Account SID e Auth Token estão no Dashboard principal

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14155238886

# ==============================================
# WHATSAPP PROVIDER
# ==============================================
# Valores possíveis: development | twilio | meta
# - development: Apenas logs no console (para testes locais)
# - twilio: Envio real via Twilio WhatsApp API (produção)
# - meta: Envio via Meta WhatsApp Business API

WHATSAPP_PROVIDER=development

# ==============================================
# OPENAI API (OPCIONAL)
# ==============================================
# Para transcrição de áudios via Whisper
# Obtenha em: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-proj-...

# ==============================================
# SERVER PORT
# ==============================================
# Porta do servidor Express
# Railway e Heroku definem automaticamente via variável PORT

PORT=3000

# ==============================================
# CONFIGURAÇÃO DE TESTES (OPCIONAL)
# ==============================================
# IDs de planilhas antigas (se existirem)

# GOOGLE_SHEETS_ID=antiga_planilha_id
# GOOGLE_SHEETS_RANGE=A1:Z1000
# GOOGLE_SHEETS_ENGINEER_SHEET=Engenheiro
# GOOGLE_SHEETS_EVANDRO_SHEET=Evandro
