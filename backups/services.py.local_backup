import os
import json
import requests
from openai import OpenAI
from tempfile import NamedTemporaryFile 
import time 

# --- Configuração do Cliente OpenAI (Correto) ---

# Inicialização tolerante: permite importar o módulo mesmo sem OPENAI_API_KEY definida.
try:
    client = OpenAI()
except Exception:
    client = None  # Será inicializado sob demanda, se necessário

def _get_openai_client() -> OpenAI:
    """Retorna um cliente OpenAI válido, inicializando se ainda não existir."""
    global client
    if client is None:
        try:
            client = OpenAI()
        except Exception as e:
            # Caso a chave ainda não esteja disponível ao chamar a função
            print(f"ERRO: A chave OPENAI_API_KEY não está configurada corretamente: {e}")
            raise ConnectionError("Chave da API OpenAI ausente ou inválida.")
    return client

# --- Funções de Ajuda para MOCK de Transcrição ---

def get_mock_transcription(audio_url: str) -> str:
    """Retorna uma transcrição mockada baseada no número de telefone."""
    
    if '5511987654321' in audio_url:
        return "Atualiza Torre do Sol para setenta e cinco por cento. Atraso no pilar 4, mas estamos adiantando a fachada."
    
    elif '5511999999999' in audio_url:
        return "Quero saber o status de todas as obras, especialmente a do Shopping Metropolitano."
        
    return "Relatório semanal concluído. O prédio Alpha está em noventa por cento de conclusão."

# --- VARIÁVEL DE AMBIENTE PARA MOCK ---
# Use para alternar facilmente entre MOCK e REAL
# Para usar o mock, defina no terminal: export USE_WHISPER_MOCK="True"
USE_WHISPER_MOCK = os.environ.get("USE_WHISPER_MOCK", "True") == "True"


# --- Integração REAL/MOCK: Transcrição (Whisper) ---
def transcrever_audio(audio_url: str) -> str:
    """
    Transcreve o áudio do WhatsApp usando Whisper (ou MOCK).
    """
    if USE_WHISPER_MOCK:
        transcricao_mock = get_mock_transcription(audio_url)
        print(f"[WHISPER MOCK] Usando a transcrição mockada: {transcricao_mock}")
        return transcricao_mock
    
    # --- CÓDIGO REAL DO WHISPER (Ativado se USE_WHISPER_MOCK for False) ---
    
    client = _get_openai_client()
    audio_path = None
    try:
        response = requests.get(audio_url, stream=True)
        response.raise_for_status()

        # Cria um arquivo temporário
        audio_path = f"/tmp/audio_{time.time()}_{os.getpid()}.ogg"
        with open(audio_path, "wb") as f:
            for chunk in response.iter_content(chunk_size=8192):
                f.write(chunk)

        with open(audio_path, "rb") as audio_file:
            transcription = client.audio.transcriptions.create(
                model="whisper-1",
                file=audio_file,
                language="pt"
            )
        return transcription.text.strip()

    except Exception as e:
        print(f"Erro no download ou na API Whisper: {e}")
        return "Erro de Transcrição"
    finally:
        if audio_path and os.path.exists(audio_path):
            os.remove(audio_path)


# --- Integração REAL: Análise LLM (GPT-4o) ---
def analisar_transcricao_llm(transcricao: str, obras_engenheiro: list, intencao: str) -> dict:
    """
    Processa a transcrição usando a API GPT-4o para extrair dados estruturados.
    """
    client = _get_openai_client()
    
    if intencao == "atualizacao":
        prompt_system = (
            "Você é um extrator de dados para engenheiros. Sua tarefa é analisar o texto de uma atualização de status de obra "
            "e retornar uma estrutura JSON com o nome da obra, o novo status e a descrição detalhada. "
            f"O engenheiro tem permissão para atualizar APENAS estas obras: {obras_engenheiro}. "
            "Se o texto não contiver uma obra válida ou um status, retorne 'sucesso: false'."
        )
        prompt_user = f"Análise a transcrição: '{transcricao}'. Quais são os dados da atualização?"
        
        json_schema = {
            "type": "object",
            "properties": {
                "sucesso": {"type": "boolean", "description": "True se todos os dados essenciais (obra e novo_status) foram encontrados."},
                "obra_nome": {"type": "string", "description": "Nome exato da obra encontrada na transcrição. Use 'N/A' se não encontrar."},
                "novo_status": {"type": "string", "description": "O novo status da obra (ex: '75%', 'Em acabamento'). Use 'N/A' se não encontrar."},
                "descricao": {"type": "string", "description": "A descrição detalhada da atualização, incluindo problemas ou avanços. Se não houver, use o novo_status."}
            },
            "required": ["sucesso", "obra_nome", "novo_status", "descricao"]
        }

    elif intencao == "consulta_ceo":
        # Esta lógica precisa ser robusta, mas vamos focar na extração do tipo de consulta
        prompt_system = "Você é um classificador de intenções para o CEO. Analise o texto e retorne o JSON com o tipo de consulta ('geral' ou 'especifica'). Se for específica, inclua o nome da obra que o CEO deseja consultar."
        prompt_user = f"Consulta do CEO: '{transcricao}'"

        json_schema = {
            "type": "object",
            "properties": {
                "sucesso": {"type": "boolean", "description": "Sempre True, a menos que o texto seja ininteligível."},
                "tipo_consulta": {"type": "string", "description": "Deve ser 'geral' (status de todas as obras) ou 'especifica' (status de uma obra em particular)."},
                "obra_nome": {"type": "string", "description": "Nome da obra, se a consulta for 'especifica'. Se for 'geral', use 'N/A'."}
            },
            "required": ["sucesso", "tipo_consulta", "obra_nome"]
        }
    
    else:
        return {"sucesso": False, "erro": "Intenção de LLM não reconhecida."}

    # Chamada à API (Comum a ambas as intenções)
    try:
        completion = client.chat.completions.create(
            model="gpt-4o", 
            messages=[
                {"role": "system", "content": prompt_system},
                {"role": "user", "content": prompt_user}
            ],
            response_format={"type": "json_object", "schema": json_schema} 
        )
        
        resultado_json = json.loads(completion.choices[0].message.content)
        print(f"[GPT-4o SUCESSO] JSON Retornado: {resultado_json}")
        return resultado_json
        
    except Exception as e:
        print(f"[GPT-4o ERRO] Falha na chamada da API: {e}")
        return {"sucesso": False, "erro": "Falha na comunicação com o LLM."}


# --- MOCK: Text-to-Speech (TTS) e WhatsApp ---

def gerar_audio_resposta(texto_resposta: str) -> str:
    """Simula a chamada à API de TTS e upload do áudio."""
    print(f"\n[MOCK TTS] Áudio gerado com o texto: {texto_resposta}")
    return "https://mock.cdn.com/audio/ceo_resposta_mock.ogg"

def enviar_mensagem_whatsapp(numero_destino: str, tipo: str, conteudo: str) -> bool:
    """Simula o envio pela API do WhatsApp Business (ou BSP)."""
    if tipo == 'texto':
        print(f"[MOCK WHATSAPP] Enviando TEXTO para {numero_destino}: {conteudo[:80]}...")
    elif tipo == 'audio':
        print(f"[MOCK WHATSAPP] Enviando ÁUDIO para {numero_destino}: {conteudo}")
    return True
