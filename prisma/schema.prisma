// Schema do Prisma para gestão de obras
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  email     String?  @unique
  telefone  String?
  cpfCnpj   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  obras     Obra[]

  @@map("clientes")
}

model Obra {
  id          String   @id @default(cuid())
  nome        String
  endereco    String?
  cidade      String?
  estado      String?
  status      String   @default("EM_ANDAMENTO") // EM_ANDAMENTO, CONCLUIDA, PAUSADA
  dataInicio  DateTime?
  dataTermino DateTime?
  clienteId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  cliente     Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  projetos    Projeto[]

  @@map("obras")
}

model Profissional {
  id           String   @id @default(cuid())
  nome         String
  especialidade String
  telefone     String?
  email        String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  projetos     Projeto[]

  @@map("profissionais")
}

model Area {
  id        String   @id @default(cuid())
  nome      String   @unique // Elétrico, Hidrossanitário, Climatização, Drenagem, Solar
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projetos  Projeto[]

  @@map("areas")
}

model Projeto {
  id              String   @id @default(cuid())
  obraId          String
  areaId          String
  profissionalId  String?
  status          String   @default("PENDENTE") // PENDENTE, EM_ANDAMENTO, CONCLUIDO
  dataInicio      DateTime?
  dataTermino     DateTime?
  observacoes     String?
  dados           String?  // JSON com dados específicos do projeto
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  obra            Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  area            Area         @relation(fields: [areaId], references: [id])
  profissional    Profissional? @relation(fields: [profissionalId], references: [id])
  acessos         Acesso[]

  @@map("projetos")
}

model Acesso {
  id          String   @id @default(cuid())
  projetoId   String
  usuarioId   String   // ID do WhatsApp
  nome        String
  acao        String   // VISUALIZOU, CADASTROU, ATUALIZOU
  dataAcesso  DateTime @default(now())
  
  projeto     Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@map("acessos")
}
